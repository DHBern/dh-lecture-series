{
	"name": "dh-lecture-series",
	"version": "0.1.0",
	"description": "DH Ringvorlesung — lecture series website, Digital Humanities, University of Bern",
	"author": {
		"name": "Tobias Hodel",
		"email": "tobias.hodel@unibe.ch",
		"url": "https://github.com/thodel"
	},
	"url": "https://github.com/DHBern/dh-lecture-series/issues",
	"license": "AGPL-3.0",
	"scripts": {
		"check": "prettier --ignore-path .gitignore --ignore-path .prettierignore  --check . '!{CODE_OF_CONDUCT.md,LICENSE-AGPL.md,LICENSE-CCBYSA.md,_layouts/default.html,package-lock.json,pnpm-lock.yaml,yarn.lock}'",
		"commit": "cz",
		"format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write . '!{CODE_OF_CONDUCT.md,LICENSE-AGPL.md,LICENSE-CCBYSA.md,_layouts/default.html,package-lock.json,pnpm-lock.yaml,yarn.lock}'",
		"prepare": "husky",
		"changelog": "npm exec git-cliff -- --config cliff.toml",
		"handout": "python3 handout/build.py",
		"editions": "python3 scripts/build_editions.py"
	},
	"devDependencies": {
		"commitizen": "^4.3.1",
		"cz": "^1.8.2",
		"cz-conventional-changelog": "^3.3.0",
		"git-cliff": "^2.10.0",
		"husky": "^9.1.7",
		"prettier": "^3.6.2"
	},
	"type": "module",
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
